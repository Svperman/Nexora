# Copier en .env puis remplir.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>/nexora?retryWrites=true&w=majority
# Laisser vide en développement => base MongoDB en mémoire (données perdues à l'arrêt).
MONGO_URI=

# Redis Cloud / Upstash : rediss://default:<password>@<host>:<port>
# Laisser vide => pas de file BullMQ (notifications traitées en direct), Socket.IO mono-instance.
REDIS_URL=

# Secrets JWT : générer avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
