# Copier en .env puis remplir.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>/nexora?retryWrites=true&w=majority
# Laisser vide en développement => base MongoDB en mémoire (données perdues à l'arrêt).
MONGO_URI=

# Redis Cloud / Upstash : rediss://default:<password>@<host>:<port>
# Laisser vide => pas de file BullMQ (notifications traitées en direct), Socket.IO mono-instance.
REDIS_URL=

# Secrets JWT : générer avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Upload d'images : cloudinary://<api_key>:<api_secret>@<cloud_name>
# Vide en développement => fichiers stockés dans server/uploads/. Obligatoire en production.
CLOUDINARY_URL=

# Modération IA (Claude). Les identifiants sont lus par le SDK : ANTHROPIC_API_KEY=...
MODERATION_ENABLED=false
# claude-opus-5-5 par défaut ; claude-haiku-5-5 coûte ~40x moins cher pour ce type de tri.
MODERATION_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Appels audio/vidéo : serveurs TURN (JSON). Sans TURN, seuls les réseaux "simples" se connectent.
# Exemple : [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
TURN_SERVERS=

# Traces OpenTelemetry (Jaeger) : http://localhost:4318 — vide = désactivé
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nexora-api
